# Used by Netlify and Cloudflare Pages (Vercel reads vercel.json instead)
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https://*.supabase.co; font-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
